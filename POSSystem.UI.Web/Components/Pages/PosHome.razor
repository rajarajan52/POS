@page "/"
@rendermode InteractiveServer

<PageTitle>POS System - Home</PageTitle>

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h4>Point of Sale System</h4>
                </div>
                <div class="card-body">
                    <p class="lead">Welcome to the Enterprise POS System</p>
                    <p>Navigate using the menu above to:</p>
                    <ul>
                        <li><strong>Products</strong> - Browse and manage catalog</li>
                        <li><strong>Cart</strong> - View and checkout items</li>
                        <li><strong>Orders</strong> - View order history</li>
                        <li><strong>Customers</strong> - Manage customer profiles</li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-light">
                <div class="card-body">
                    <h5 class="card-title">System Status</h5>
                    <p class="card-text">
                        <span class="badge bg-success">All Services Online</span>
                    </p>
                    <hr />
                    <small class="text-muted">
                        <p>• Product Service</p>
                        <p>• Inventory Service</p>
                        <p>• Order Service</p>
                        <p>• Customer Service</p>
                        <p>• Payment Service</p>
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>
